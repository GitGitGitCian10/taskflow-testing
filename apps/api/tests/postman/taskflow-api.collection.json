          "name": "Crear proyecto (US-03)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Proyecto creado con status 201', () => { \r",
                  "  pm.response.to.have.status(201); \r",
                  "}); \r",
                  " \r",
                  "pm.test('Response tiene id, name y status activo', () => { \r",
                  "  const body = pm.response.json(); \r",
                  "  pm.expect(body.id).to.be.a('string'); \r",
                  "  pm.expect(body.name).to.eql('Mi proyecto de testing'); \r",
                  "  pm.environment.set('project_id', body.id); \r",
                  "}); "
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \r\n    \"name\": \"Mi proyecto de testing\",\r\n    \"description\": \"Creado en la práctica Clase 4\"\r\n} ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Crear tarea (US-05) y capturar task_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tarea creada con status TODO', () => { ",
                  "  pm.response.to.have.status(201); ",
                  "  const body = pm.response.json(); ",
                  "  pm.expect(body.status).to.eql('TODO'); ",
                  "  pm.environment.set('task_id', body.id); ",
                  "}); ",
                  " ",
                  "pm.test('Priority HIGH se persistió correctamente', () => { ",
                  "  pm.expect(pm.response.json().priority).to.eql('HIGH'); ",
                  "});",
                  "",
                  "// US-05 | Edge Case — Título vacío → 400 Bad Request",
                  "pm.test('[US-05] Título vacío → 400 Bad Request', () => {",
                  "  // Este test se activa solo si el response es 400",
                  "  // Para ejecutarlo: enviar el request con \"title\": \"\"",
                  "  if (pm.response.code === 400) {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "  } else {",
                  "    // Si el status no es 400, marcar como skipped con nota",
                  "    console.warn('[US-05 Edge Case] Este test requiere enviar title vacío (\"\"). Status actual: ' + pm.response.code);",
                  "    pm.expect(true).to.be.true; // no falla el run normal",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}} ",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \r\n  \"title\": \"Configurar colección Postman\", \r\n  \"priority\": \"HIGH\" \r\n} ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
