{
  "name": "taskflow",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema apps/api/src/prisma/schema.prisma",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build:api": "tsc --project apps/api/tsconfig.json",
    "start:api": "node apps/api/dist/index.js",
    "lint:api": "eslint apps/api/src apps/api/tests",
    "typecheck:api": "tsc --noEmit --project apps/api/tsconfig.json",
    "test:api:unit": "vitest run apps/api/tests/unit --coverage --config apps/api/vitest.config.ts",
    "test:api:integration": "vitest run apps/api/tests/integration --config apps/api/vitest.config.ts",
    "test:api:bdd": "cucumber-js",
    "test:api:watch": "vitest --config apps/api/vitest.config.ts",
    "dev:web": "vite apps/web --port 5173",
    "build:web": "tsc --project apps/web/tsconfig.json && vite build apps/web",
    "preview:web": "vite preview apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "test:all": "npm run test:api:unit && npm run test:api:integration && npm run test:api:bdd && npx playwright test",
    "test": "npm run test:api:unit",
    "test:watch": "npm run test:api:watch",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run test && npm run allure:generate && npm run allure:open"
  },
  "prisma": {
    "schema": "apps/api/src/prisma/schema.prisma",
    "seed": "tsx apps/api/src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.44.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "allure-commandline": "^2.42.1",
    "allure-js-commons": "^3.9.0",
    "allure-vitest": "^3.9.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.4.0",
    "globals": "^17.4.0",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.11.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^1.6.0"
  }
}
